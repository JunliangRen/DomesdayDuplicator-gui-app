<!--
    Data Conversion page: convert between 10-bit and 16-bit formats,
    verify test data integrity.
-->
<Page
    x:Class="DomesdayDuplicator.WinUI.Views.DataConversionPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:DomesdayDuplicator.WinUI.Converters"
    NavigationCacheMode="Required">

    <Page.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVis" />
    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="36,24,36,24">
        <StackPanel Spacing="16" MaxWidth="960">

            <TextBlock Text="Data Conversion"
                       Style="{StaticResource TitleTextBlockStyle}"
                       Margin="0,0,0,8" />

            <!-- ── Input File Card ─────────────────────────────── -->
            <Border Style="{StaticResource CardStyle}">
                <StackPanel Padding="24" Spacing="16">
                    <TextBlock Text="Input File"
                               Style="{StaticResource SubtitleTextBlockStyle}" />

                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBox Grid.Column="0" IsReadOnly="True"
                                 PlaceholderText="Select an input file..."
                                 Text="{x:Bind ViewModel.InputFilePath, Mode=OneWay}" />

                        <Button Grid.Column="1" Content="Open 10-bit..."
                                Click="OpenTenBitFile_Click" />
                        <Button Grid.Column="2" Content="Open 16-bit..."
                                Click="OpenSixteenBitFile_Click" />
                    </Grid>

                    <!-- File info -->
                    <Grid ColumnSpacing="24"
                          Visibility="{x:Bind ViewModel.InputFilePath, Mode=OneWay, Converter={StaticResource StringToVisConverter}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Spacing="2">
                            <TextBlock Text="Samples"
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock Text="{x:Bind ViewModel.SampleCountText, Mode=OneWay}"
                                       Style="{StaticResource BodyStrongTextBlockStyle}" />
                        </StackPanel>

                        <StackPanel Grid.Column="1" Spacing="2">
                            <TextBlock Text="File Size"
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock Text="{x:Bind ViewModel.FileSizeText, Mode=OneWay}"
                                       Style="{StaticResource BodyStrongTextBlockStyle}" />
                        </StackPanel>

                        <StackPanel Grid.Column="2" Spacing="2">
                            <TextBlock Text="Duration"
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock Text="{x:Bind ViewModel.DurationText, Mode=OneWay}"
                                       Style="{StaticResource BodyStrongTextBlockStyle}" />
                        </StackPanel>

                        <StackPanel Grid.Column="3" Spacing="2">
                            <TextBlock Text="Format"
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock Text="{x:Bind ViewModel.FormatText, Mode=OneWay}"
                                       Style="{StaticResource BodyStrongTextBlockStyle}" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- ── Conversion Card ─────────────────────────────── -->
            <Border Style="{StaticResource CardStyle}">
                <StackPanel Padding="24" Spacing="16">
                    <TextBlock Text="Convert"
                               Style="{StaticResource SubtitleTextBlockStyle}" />

                    <StackPanel Orientation="Horizontal" Spacing="24">
                        <RadioButton Content="Save as 10-bit packed"
                                     IsChecked="{x:Bind ViewModel.OutputAsTenBit, Mode=TwoWay}"
                                     GroupName="OutputFormat" />
                        <RadioButton Content="Save as 16-bit signed"
                                     IsChecked="{x:Bind ViewModel.OutputAsSixteenBit, Mode=TwoWay}"
                                     GroupName="OutputFormat" />
                    </StackPanel>

                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Spacing="8">
                            <ProgressBar Value="{x:Bind ViewModel.ConversionProgress, Mode=OneWay}"
                                         Maximum="1.0"
                                         Visibility="{x:Bind ViewModel.IsConverting, Mode=OneWay, Converter={StaticResource BoolToVis}}" />
                            <TextBlock Text="{x:Bind ViewModel.ConversionStatusText, Mode=OneWay}"
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Top">
                            <Button Content="Convert..."
                                    Click="SaveConvertedFile_Click"
                                    Style="{StaticResource AccentButtonStyle}"
                                    IsEnabled="{x:Bind ViewModel.IsConverting, Mode=OneWay, Converter={StaticResource InvertBoolConverter}}" />
                            <Button Content="Cancel"
                                    Command="{x:Bind ViewModel.CancelConversionCommand}"
                                    Visibility="{x:Bind ViewModel.IsConverting, Mode=OneWay, Converter={StaticResource BoolToVis}}" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- ── Test Data Verification Card ─────────────────── -->
            <Border Style="{StaticResource CardStyle}">
                <StackPanel Padding="24" Spacing="16">
                    <TextBlock Text="Test Data Verification"
                               Style="{StaticResource SubtitleTextBlockStyle}" />

                    <TextBlock TextWrapping="Wrap"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}">
                        Verify the integrity of captured test data by checking the incrementing
                        counter pattern generated by the FPGA firmware.
                    </TextBlock>

                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Spacing="8">
                            <ProgressBar Value="{x:Bind ViewModel.VerifyProgress, Mode=OneWay}"
                                         Maximum="1.0"
                                         Visibility="{x:Bind ViewModel.IsVerifying, Mode=OneWay, Converter={StaticResource BoolToVis}}" />
                            <TextBlock Text="{x:Bind ViewModel.VerifyStatusText, Mode=OneWay}"
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>

                        <Button Grid.Column="1"
                                Content="Verify Test Data"
                                Command="{x:Bind ViewModel.VerifyTestDataCommand}"
                                VerticalAlignment="Top" />
                    </Grid>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</Page>
