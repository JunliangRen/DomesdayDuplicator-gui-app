<!--
    Player Control page: LaserDisc player remote control emulation.
    Modeled after the original Qt playerremotedialog.ui.
-->
<Page
    x:Class="DomesdayDuplicator.WinUI.Views.PlayerControlPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:DomesdayDuplicator.WinUI.Converters"
    NavigationCacheMode="Required">

    <Page.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVis" />
    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="36,24,36,24">
        <StackPanel Spacing="16" MaxWidth="960">

            <TextBlock Text="Player Control"
                       Style="{StaticResource TitleTextBlockStyle}"
                       Margin="0,0,0,8" />

            <!-- ── Connection Card ─────────────────────────────── -->
            <Border Style="{StaticResource CardStyle}">
                <Grid Padding="24" ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <ComboBox Grid.Column="0" Header="Serial Port"
                              ItemsSource="{x:Bind ViewModel.AvailablePorts, Mode=OneWay}"
                              SelectedItem="{x:Bind ViewModel.SelectedPort, Mode=TwoWay}"
                              MinWidth="200" />

                    <Button Grid.Column="1" Content="Refresh"
                            Command="{x:Bind ViewModel.RefreshPortsCommand}"
                            VerticalAlignment="Bottom" />

                    <Button Grid.Column="2"
                            Command="{x:Bind ViewModel.ToggleConnectionCommand}"
                            Style="{StaticResource AccentButtonStyle}"
                            VerticalAlignment="Bottom"
                            MinWidth="120">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="{x:Bind ViewModel.IsConnected, Mode=OneWay, Converter={StaticResource ConnectionGlyphConverter}}"
                                      FontSize="16" />
                            <TextBlock Text="{x:Bind ViewModel.IsConnected, Mode=OneWay, Converter={StaticResource ConnectionTextConverter}}" />
                        </StackPanel>
                    </Button>

                    <TextBlock Grid.Column="3"
                               Text="{x:Bind ViewModel.StatusText, Mode=OneWay}"
                               VerticalAlignment="Center"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </Grid>
            </Border>

            <!-- ── Display Card ────────────────────────────────── -->
            <Border Style="{StaticResource CardStyle}">
                <StackPanel Padding="24" Spacing="8">
                    <TextBlock Text="Player Display"
                               Style="{StaticResource SubtitleTextBlockStyle}" />

                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" CornerRadius="8"
                                Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                Padding="16,12" MinHeight="56">
                            <StackPanel>
                                <TextBlock Text="Time Code / Frame"
                                           Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock Text="{x:Bind ViewModel.TimeCodeText, Mode=OneWay}"
                                           Style="{StaticResource SubtitleTextBlockStyle}"
                                           FontFamily="Consolas" />
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="1" CornerRadius="8"
                                Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                Padding="16,12" MinHeight="56">
                            <StackPanel>
                                <TextBlock Text="Entry"
                                           Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock Text="{x:Bind ViewModel.EntryText, Mode=OneWay}"
                                           Style="{StaticResource SubtitleTextBlockStyle}"
                                           FontFamily="Consolas" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- ── Remote Control Card ─────────────────────────── -->
            <Border Style="{StaticResource CardStyle}">
                <StackPanel Padding="24" Spacing="16">
                    <TextBlock Text="Remote Control"
                               Style="{StaticResource SubtitleTextBlockStyle}" />

                    <!-- Playback controls -->
                    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                        <Button Command="{x:Bind ViewModel.StepReverseCommand}" ToolTipService.ToolTip="Step Reverse"
                                Width="56" Height="56" CornerRadius="28">
                            <FontIcon Glyph="&#xED3C;" FontSize="20" />
                        </Button>
                        <Button Command="{x:Bind ViewModel.ScanReverseCommand}" ToolTipService.ToolTip="Scan Reverse"
                                Width="56" Height="56" CornerRadius="28">
                            <FontIcon Glyph="&#xEB9E;" FontSize="20" />
                        </Button>
                        <Button Command="{x:Bind ViewModel.PauseCommand}" ToolTipService.ToolTip="Pause"
                                Width="56" Height="56" CornerRadius="28">
                            <FontIcon Glyph="&#xE769;" FontSize="20" />
                        </Button>
                        <Button Command="{x:Bind ViewModel.PlayCommand}" ToolTipService.ToolTip="Play"
                                Width="64" Height="64" CornerRadius="32"
                                Style="{StaticResource AccentButtonStyle}">
                            <FontIcon Glyph="&#xE768;" FontSize="24" />
                        </Button>
                        <Button Command="{x:Bind ViewModel.StopCommand}" ToolTipService.ToolTip="Stop"
                                Width="56" Height="56" CornerRadius="28">
                            <FontIcon Glyph="&#xE71A;" FontSize="20" />
                        </Button>
                        <Button Command="{x:Bind ViewModel.ScanForwardCommand}" ToolTipService.ToolTip="Scan Forward"
                                Width="56" Height="56" CornerRadius="28">
                            <FontIcon Glyph="&#xEB9D;" FontSize="20" />
                        </Button>
                        <Button Command="{x:Bind ViewModel.StepForwardCommand}" ToolTipService.ToolTip="Step Forward"
                                Width="56" Height="56" CornerRadius="28">
                            <FontIcon Glyph="&#xED3D;" FontSize="20" />
                        </Button>
                    </StackPanel>

                    <!-- Speed / function controls -->
                    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                        <Button Command="{x:Bind ViewModel.MultiSpeedReverseCommand}" Content="Multi ◀"
                                MinWidth="80" />
                        <Button Command="{x:Bind ViewModel.SpeedDownCommand}" Content="Speed −"
                                MinWidth="80" />
                        <Button Command="{x:Bind ViewModel.SpeedUpCommand}" Content="Speed +"
                                MinWidth="80" />
                        <Button Command="{x:Bind ViewModel.MultiSpeedForwardCommand}" Content="Multi ▶"
                                MinWidth="80" />
                        <Button Command="{x:Bind ViewModel.DisplayCommand}" Content="Display"
                                MinWidth="80" />
                        <Button Command="{x:Bind ViewModel.AudioCommand}" Content="Audio"
                                MinWidth="80" />
                    </StackPanel>

                    <!-- Numeric keypad -->
                    <Grid HorizontalAlignment="Center" ColumnSpacing="8" RowSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="64" />
                            <ColumnDefinition Width="64" />
                            <ColumnDefinition Width="64" />
                            <ColumnDefinition Width="64" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="48" />
                            <RowDefinition Height="48" />
                            <RowDefinition Height="48" />
                            <RowDefinition Height="48" />
                        </Grid.RowDefinitions>

                        <Button Grid.Row="0" Grid.Column="0" Content="1" HorizontalAlignment="Stretch"
                                Command="{x:Bind ViewModel.DigitCommand}" CommandParameter="1" />
                        <Button Grid.Row="0" Grid.Column="1" Content="2" HorizontalAlignment="Stretch"
                                Command="{x:Bind ViewModel.DigitCommand}" CommandParameter="2" />
                        <Button Grid.Row="0" Grid.Column="2" Content="3" HorizontalAlignment="Stretch"
                                Command="{x:Bind ViewModel.DigitCommand}" CommandParameter="3" />
                        <Button Grid.Row="0" Grid.Column="3" Content="Reject" HorizontalAlignment="Stretch"
                                Command="{x:Bind ViewModel.RejectCommand}" FontSize="11" />

                        <Button Grid.Row="1" Grid.Column="0" Content="4" HorizontalAlignment="Stretch"
                                Command="{x:Bind ViewModel.DigitCommand}" CommandParameter="4" />
                        <Button Grid.Row="1" Grid.Column="1" Content="5" HorizontalAlignment="Stretch"
                                Command="{x:Bind ViewModel.DigitCommand}" CommandParameter="5" />
                        <Button Grid.Row="1" Grid.Column="2" Content="6" HorizontalAlignment="Stretch"
                                Command="{x:Bind ViewModel.DigitCommand}" CommandParameter="6" />
                        <Button Grid.Row="1" Grid.Column="3" Content="Repeat" HorizontalAlignment="Stretch"
                                Command="{x:Bind ViewModel.RepeatCommand}" FontSize="11" />

                        <Button Grid.Row="2" Grid.Column="0" Content="7" HorizontalAlignment="Stretch"
                                Command="{x:Bind ViewModel.DigitCommand}" CommandParameter="7" />
                        <Button Grid.Row="2" Grid.Column="1" Content="8" HorizontalAlignment="Stretch"
                                Command="{x:Bind ViewModel.DigitCommand}" CommandParameter="8" />
                        <Button Grid.Row="2" Grid.Column="2" Content="9" HorizontalAlignment="Stretch"
                                Command="{x:Bind ViewModel.DigitCommand}" CommandParameter="9" />
                        <Button Grid.Row="2" Grid.Column="3" Content="Search" HorizontalAlignment="Stretch"
                                Command="{x:Bind ViewModel.SearchCommand}"
                                Style="{StaticResource AccentButtonStyle}" FontSize="11" />

                        <Button Grid.Row="3" Grid.Column="0" Content="Clear" HorizontalAlignment="Stretch"
                                Command="{x:Bind ViewModel.ClearCommand}" />
                        <Button Grid.Row="3" Grid.Column="1" Content="0" HorizontalAlignment="Stretch"
                                Command="{x:Bind ViewModel.DigitCommand}" CommandParameter="0" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- ── Manual Serial Command Card ──────────────────── -->
            <Border Style="{StaticResource CardStyle}">
                <StackPanel Padding="24" Spacing="12">
                    <TextBlock Text="Manual Serial Command"
                               Style="{StaticResource SubtitleTextBlockStyle}" />

                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBox Grid.Column="0"
                                 PlaceholderText="Enter serial command (e.g. PL, PA, ?F)..."
                                 Text="{x:Bind ViewModel.ManualCommand, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 FontFamily="Consolas" />

                        <Button Grid.Column="1" Content="Send"
                                Command="{x:Bind ViewModel.SendManualCommandCommand}"
                                Style="{StaticResource AccentButtonStyle}" />
                    </Grid>

                    <TextBox Header="Response" IsReadOnly="True"
                             Text="{x:Bind ViewModel.ManualResponse, Mode=OneWay}"
                             FontFamily="Consolas"
                             Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" />
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</Page>
