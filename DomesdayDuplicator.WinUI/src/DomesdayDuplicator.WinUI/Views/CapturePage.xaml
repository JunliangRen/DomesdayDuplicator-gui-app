<!--
    Capture page: main capture controls, real-time statistics,
    disc metadata, and amplitude monitoring.
-->
<Page
    x:Class="DomesdayDuplicator.WinUI.Views.CapturePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:DomesdayDuplicator.WinUI.Converters"
    NavigationCacheMode="Required">

    <Page.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVis" />
        <converters:TimeSpanConverter x:Key="TimeSpanConv" />
    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="36,24,36,24">
        <StackPanel Spacing="16" MaxWidth="960">

            <!-- Page header -->
            <TextBlock Text="RF Capture"
                       Style="{StaticResource TitleTextBlockStyle}"
                       Margin="0,0,0,8" />

            <!-- ── Main Capture Control Card ───────────────────── -->
            <Border Style="{StaticResource CardStyle}">
                <Grid Padding="24" RowSpacing="16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Capture button + status -->
                    <Grid Grid.Row="0" ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="0"
                                MinWidth="160" MinHeight="48"
                                Command="{x:Bind ViewModel.StartCaptureCommand}"
                                Visibility="{x:Bind ViewModel.IsCapturing, Mode=OneWay, Converter={StaticResource BoolToVis}, ConverterParameter=invert}"
                                Style="{StaticResource AccentButtonStyle}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE7C8;" FontSize="18" />
                                <TextBlock Text="Start Capture" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <Button Grid.Column="0"
                                MinWidth="160" MinHeight="48"
                                Command="{x:Bind ViewModel.StopCaptureCommand}"
                                Visibility="{x:Bind ViewModel.IsCapturing, Mode=OneWay, Converter={StaticResource BoolToVis}}"
                                Background="#E81123" Foreground="White">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE71A;" FontSize="18" />
                                <TextBlock Text="Stop Capture" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                            <TextBlock Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                                       Style="{StaticResource BodyStrongTextBlockStyle}" />
                            <ProgressBar IsIndeterminate="{x:Bind ViewModel.IsCapturing, Mode=OneWay}"
                                         Visibility="{x:Bind ViewModel.IsCapturing, Mode=OneWay, Converter={StaticResource BoolToVis}}"
                                         ShowPaused="False" ShowError="False" />
                        </StackPanel>
                    </Grid>

                    <!-- Capture options -->
                    <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="24">
                        <CheckBox Content="Test Mode"
                                  IsChecked="{x:Bind ViewModel.IsTestMode, Mode=TwoWay}" />
                        <CheckBox Content="Limit Duration"
                                  IsChecked="{x:Bind ViewModel.LimitDuration, Mode=TwoWay}" />
                        <TimePicker Header="Duration Limit"
                                    Visibility="{x:Bind ViewModel.LimitDuration, Mode=OneWay, Converter={StaticResource BoolToVis}}"
                                    ClockIdentifier="24HourClock" />
                    </StackPanel>

                    <!-- Not connected warning -->
                    <InfoBar Grid.Row="2"
                             IsOpen="{x:Bind ViewModel.IsDeviceConnected, Mode=OneWay, Converter={StaticResource BoolToVis}, ConverterParameter=invert}"
                             Severity="Warning"
                             Title="No device connected"
                             Message="Connect a Domesday Duplicator device to begin capturing."
                             IsClosable="False" />
                </Grid>
            </Border>

            <!-- ── Disc Metadata Card ──────────────────────────── -->
            <Border Style="{StaticResource CardStyle}">
                <StackPanel Padding="24" Spacing="16">
                    <TextBlock Text="Disc Information"
                               Style="{StaticResource SubtitleTextBlockStyle}" />

                    <Grid ColumnSpacing="16" RowSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition />
                            <RowDefinition />
                            <RowDefinition />
                        </Grid.RowDefinitions>

                        <TextBox Grid.Row="0" Grid.Column="0"
                                 Header="Disc Title"
                                 PlaceholderText="Enter disc title..."
                                 Text="{x:Bind ViewModel.DiscTitle, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                        <ComboBox Grid.Row="0" Grid.Column="1"
                                  Header="Audio Type" Width="200"
                                  SelectedItem="{x:Bind ViewModel.AudioType, Mode=TwoWay}">
                            <x:String>Stereo</x:String>
                            <x:String>Monaural</x:String>
                            <x:String>Surround</x:String>
                            <x:String>Bilingual</x:String>
                        </ComboBox>

                        <StackPanel Grid.Row="1" Grid.Column="0" Orientation="Horizontal" Spacing="16">
                            <RadioButton Content="CAV" GroupName="DiscType"
                                         IsChecked="{x:Bind ViewModel.IsCav, Mode=TwoWay}" />
                            <RadioButton Content="CLV" GroupName="DiscType" />
                        </StackPanel>

                        <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Spacing="16">
                            <RadioButton Content="NTSC" GroupName="VideoStd"
                                         IsChecked="{x:Bind ViewModel.IsNtsc, Mode=TwoWay}" />
                            <RadioButton Content="PAL" GroupName="VideoStd" />
                        </StackPanel>

                        <NumberBox Grid.Row="2" Grid.Column="0"
                                   Header="Side Number"
                                   Value="{x:Bind ViewModel.SideNumber, Mode=TwoWay}"
                                   Minimum="1" Maximum="2"
                                   SpinButtonPlacementMode="Compact" />

                        <TextBox Grid.Row="2" Grid.Column="1"
                                 Header="Capture Notes"
                                 PlaceholderText="Optional notes..."
                                 Text="{x:Bind ViewModel.CaptureNotes, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- ── Live Statistics Card ────────────────────────── -->
            <Border Style="{StaticResource CardStyle}"
                    Visibility="{x:Bind ViewModel.IsCapturing, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                <StackPanel Padding="24" Spacing="16">
                    <TextBlock Text="Capture Statistics"
                               Style="{StaticResource SubtitleTextBlockStyle}" />

                    <Grid ColumnSpacing="16" RowSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition />
                            <RowDefinition />
                            <RowDefinition />
                        </Grid.RowDefinitions>

                        <!-- Row 1 -->
                        <StackPanel Grid.Row="0" Grid.Column="0" Spacing="2">
                            <TextBlock Text="Elapsed Time"
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock Text="{x:Bind ViewModel.Statistics.ElapsedTime, Mode=OneWay, Converter={StaticResource TimeSpanConv}}"
                                       Style="{StaticResource BodyStrongTextBlockStyle}" />
                        </StackPanel>

                        <StackPanel Grid.Row="0" Grid.Column="1" Spacing="2">
                            <TextBlock Text="File Size"
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock Text="{x:Bind ViewModel.Statistics.FormattedFileSize, Mode=OneWay}"
                                       Style="{StaticResource BodyStrongTextBlockStyle}" />
                        </StackPanel>

                        <StackPanel Grid.Row="0" Grid.Column="2" Spacing="2">
                            <TextBlock Text="USB Transfers"
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock Text="{x:Bind ViewModel.Statistics.TotalTransfers, Mode=OneWay}"
                                       Style="{StaticResource BodyStrongTextBlockStyle}" />
                        </StackPanel>

                        <!-- Row 2 -->
                        <StackPanel Grid.Row="1" Grid.Column="0" Spacing="2">
                            <TextBlock Text="Sample Min"
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock Text="{x:Bind ViewModel.Statistics.MinSampleValue, Mode=OneWay}"
                                       Style="{StaticResource BodyStrongTextBlockStyle}" />
                        </StackPanel>

                        <StackPanel Grid.Row="1" Grid.Column="1" Spacing="2">
                            <TextBlock Text="Sample Max"
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock Text="{x:Bind ViewModel.Statistics.MaxSampleValue, Mode=OneWay}"
                                       Style="{StaticResource BodyStrongTextBlockStyle}" />
                        </StackPanel>

                        <StackPanel Grid.Row="1" Grid.Column="2" Spacing="2">
                            <TextBlock Text="RMS Amplitude"
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}">
                                <Run Text="{x:Bind ViewModel.RmsAmplitude, Mode=OneWay}" />
                            </TextBlock>
                        </StackPanel>

                        <!-- Row 3 -->
                        <StackPanel Grid.Row="2" Grid.Column="0" Spacing="2">
                            <TextBlock Text="Clipped Low"
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock Text="{x:Bind ViewModel.Statistics.ClippedMinCount, Mode=OneWay}"
                                       Style="{StaticResource BodyStrongTextBlockStyle}" />
                        </StackPanel>

                        <StackPanel Grid.Row="2" Grid.Column="1" Spacing="2">
                            <TextBlock Text="Clipped High"
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock Text="{x:Bind ViewModel.Statistics.ClippedMaxCount, Mode=OneWay}"
                                       Style="{StaticResource BodyStrongTextBlockStyle}" />
                        </StackPanel>

                        <StackPanel Grid.Row="2" Grid.Column="2" Spacing="2">
                            <TextBlock Text="Buffers Written"
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock Text="{x:Bind ViewModel.Statistics.DiskBuffersWritten, Mode=OneWay}"
                                       Style="{StaticResource BodyStrongTextBlockStyle}" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</Page>
