<!--
    Dashboard page: device status, quick capture info, disk space.
    Uses card-based layout with modern WinUI 3 styling.
-->
<Page
    x:Class="DomesdayDuplicator.WinUI.Views.DashboardPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:DomesdayDuplicator.WinUI.Converters"
    NavigationCacheMode="Required">

    <Page.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVis" />
    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="36,24,36,24">
        <StackPanel Spacing="16" MaxWidth="960">

            <!-- Page header -->
            <TextBlock Text="Dashboard"
                       Style="{StaticResource TitleTextBlockStyle}"
                       Margin="0,0,0,8" />

            <!-- ── Device Status Card ──────────────────────────── -->
            <Border Style="{StaticResource CardStyle}">
                <Grid Padding="24" ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Status indicator dot -->
                    <Ellipse Grid.Column="0" Width="16" Height="16"
                             VerticalAlignment="Center">
                        <Ellipse.Fill>
                            <SolidColorBrush Color="{x:Bind ViewModel.IsDeviceConnected, Mode=OneWay, Converter={StaticResource BoolToColorConverter}}" />
                        </Ellipse.Fill>
                    </Ellipse>

                    <StackPanel Grid.Column="1" Spacing="4">
                        <TextBlock Text="{x:Bind ViewModel.DeviceStatusText, Mode=OneWay}"
                                   Style="{StaticResource SubtitleTextBlockStyle}" />
                        <TextBlock Text="{x:Bind ViewModel.DeviceDescription, Mode=OneWay}"
                                   Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>

                    <Button Grid.Column="2" Content="Scan"
                            Command="{x:Bind ViewModel.TryScanForDeviceCommand}"
                            Style="{StaticResource AccentButtonStyle}"
                            VerticalAlignment="Center" />
                </Grid>
            </Border>

            <!-- ── Info Cards Row ──────────────────────────────── -->
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Disk Space Card -->
                <Border Grid.Column="0" Style="{StaticResource CardStyle}">
                    <StackPanel Padding="24" Spacing="8">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xEDA2;" FontSize="18"
                                      Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                            <TextBlock Text="Disk Space"
                                       Style="{StaticResource BodyStrongTextBlockStyle}" />
                        </StackPanel>
                        <TextBlock Text="{x:Bind ViewModel.DiskFreeText, Mode=OneWay}"
                                   Style="{StaticResource HeaderTextBlockStyle}"
                                   Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                        <TextBlock Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}">
                            <Run Text="Available free space" />
                        </TextBlock>
                    </StackPanel>
                </Border>

                <!-- Capturable Time Card -->
                <Border Grid.Column="1" Style="{StaticResource CardStyle}">
                    <StackPanel Padding="24" Spacing="8">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE916;" FontSize="18"
                                      Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                            <TextBlock Text="Capture Time"
                                       Style="{StaticResource BodyStrongTextBlockStyle}" />
                        </StackPanel>
                        <TextBlock Text="{x:Bind ViewModel.DiskCapturableTime, Mode=OneWay}"
                                   Style="{StaticResource HeaderTextBlockStyle}"
                                   Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                        <TextBlock Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}">
                            <Run Text="Max capture duration" />
                        </TextBlock>
                    </StackPanel>
                </Border>

                <!-- Sample Rate Card -->
                <Border Grid.Column="2" Style="{StaticResource CardStyle}">
                    <StackPanel Padding="24" Spacing="8">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE9D9;" FontSize="18"
                                      Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                            <TextBlock Text="Sample Rate"
                                       Style="{StaticResource BodyStrongTextBlockStyle}" />
                        </StackPanel>
                        <TextBlock Text="40 MHz"
                                   Style="{StaticResource HeaderTextBlockStyle}"
                                   Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                        <TextBlock Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}">
                            <Run Text="RF sampling rate" />
                        </TextBlock>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ── Capture Statistics Card (visible during capture) ── -->
            <Border Style="{StaticResource CardStyle}"
                    Visibility="{x:Bind ViewModel.IsCapturing, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                <StackPanel Padding="24" Spacing="12">
                    <TextBlock Text="Live Capture Statistics"
                               Style="{StaticResource SubtitleTextBlockStyle}" />

                    <Grid ColumnSpacing="24" RowSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition />
                            <RowDefinition />
                            <RowDefinition />
                            <RowDefinition />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}">
                            <Run Text="File Size: " />
                            <Run Text="{x:Bind ViewModel.Statistics.FormattedFileSize, Mode=OneWay}"
                                 FontWeight="SemiBold"
                                 Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                        </TextBlock>

                        <TextBlock Grid.Row="0" Grid.Column="1"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}">
                            <Run Text="Transfers: " />
                            <Run Text="{x:Bind ViewModel.Statistics.TotalTransfers, Mode=OneWay}"
                                 FontWeight="SemiBold"
                                 Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                        </TextBlock>

                        <TextBlock Grid.Row="1" Grid.Column="0"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}">
                            <Run Text="Sample Min: " />
                            <Run Text="{x:Bind ViewModel.Statistics.MinSampleValue, Mode=OneWay}"
                                 FontWeight="SemiBold"
                                 Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                        </TextBlock>

                        <TextBlock Grid.Row="1" Grid.Column="1"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}">
                            <Run Text="Sample Max: " />
                            <Run Text="{x:Bind ViewModel.Statistics.MaxSampleValue, Mode=OneWay}"
                                 FontWeight="SemiBold"
                                 Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                        </TextBlock>

                        <TextBlock Grid.Row="2" Grid.Column="0"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}">
                            <Run Text="RMS Amplitude: " />
                            <Run Text="{x:Bind ViewModel.Statistics.RmsAmplitude, Mode=OneWay}"
                                 FontWeight="SemiBold"
                                 Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                        </TextBlock>

                        <TextBlock Grid.Row="2" Grid.Column="1"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}">
                            <Run Text="Buffers Written: " />
                            <Run Text="{x:Bind ViewModel.Statistics.DiskBuffersWritten, Mode=OneWay}"
                                 FontWeight="SemiBold"
                                 Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                        </TextBlock>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- ── Architecture Info Card ──────────────────────── -->
            <Border Style="{StaticResource CardStyle}">
                <StackPanel Padding="24" Spacing="12">
                    <TextBlock Text="Real-Time Architecture"
                               Style="{StaticResource SubtitleTextBlockStyle}" />
                    <TextBlock TextWrapping="Wrap" LineHeight="22"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}">
                        This application uses <Bold>NativeMemory</Bold> for all USB capture buffers,
                        ensuring the .NET garbage collector never pauses the data pipeline.
                        The three-thread architecture (USB → Processing → Disk I/O) operates
                        entirely on unmanaged memory with zero managed allocations in the hot path.
                    </TextBlock>

                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" CornerRadius="8"
                                Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                Padding="12,8">
                            <StackPanel HorizontalAlignment="Center" Spacing="4">
                                <FontIcon Glyph="&#xE839;" HorizontalAlignment="Center"
                                          Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                <TextBlock Text="USB Thread" HorizontalAlignment="Center"
                                           Style="{StaticResource CaptionTextBlockStyle}" FontWeight="SemiBold" />
                                <TextBlock Text="WinUSB + NativeMemory" HorizontalAlignment="Center"
                                           Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                        </Border>

                        <FontIcon Grid.Column="1" Glyph="&#xE72A;" FontSize="16"
                                  VerticalAlignment="Center"
                                  Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                        <Border Grid.Column="2" CornerRadius="8"
                                Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                Padding="12,8">
                            <StackPanel HorizontalAlignment="Center" Spacing="4">
                                <FontIcon Glyph="&#xE9D9;" HorizontalAlignment="Center"
                                          Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                <TextBlock Text="Processing" HorizontalAlignment="Center"
                                           Style="{StaticResource CaptionTextBlockStyle}" FontWeight="SemiBold" />
                                <TextBlock Text="Validate + Convert" HorizontalAlignment="Center"
                                           Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                        </Border>

                        <FontIcon Grid.Column="3" Glyph="&#xE72A;" FontSize="16"
                                  VerticalAlignment="Center"
                                  Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                        <Border Grid.Column="4" CornerRadius="8"
                                Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                Padding="12,8">
                            <StackPanel HorizontalAlignment="Center" Spacing="4">
                                <FontIcon Glyph="&#xE8F1;" HorizontalAlignment="Center"
                                          Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                <TextBlock Text="Disk I/O" HorizontalAlignment="Center"
                                           Style="{StaticResource CaptionTextBlockStyle}" FontWeight="SemiBold" />
                                <TextBlock Text="WriteThrough" HorizontalAlignment="Center"
                                           Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</Page>
